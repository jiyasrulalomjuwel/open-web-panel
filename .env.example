# OpenWebPanel Environment Configuration
# Copy this file to .env and adjust values for your deployment

# Database (SQLite)
OWP_DB_PATH=./openwebpanel.db

# JWT Secret — MUST be set to a random secret string in production
OWP_JWT_SECRET=change-this-to-a-random-secret-string

# Initial admin username & password (used on first run if no admin exists)
# OWP_ADMIN_PASSWORD is required and has no default — set it during install.
OWP_ADMIN_USERNAME=admin
OWP_ADMIN_PASSWORD=<set-during-install>

# Home directories base (where user accounts live)
OWP_HOMES_BASE=./homes/

# Static frontend files (built SPA)
OWP_ADMIN_STATIC_DIR=./web/dist/admin
OWP_CHILD_STATIC_DIR=./web/dist/child

# Listen addresses for the API backends (loopback by default; nginx proxies to them)
OWP_ADMIN_LISTEN=127.0.0.1:9000
OWP_CHILD_LISTEN=127.0.0.1:9001

# Public host (used for URL generation)
OWP_PUBLIC_HOST=your-server-ip

# Shared IP address of the server (a non-loopback address is required)
OWP_SHARED_IP=your-server-ip

# Comma-separated trusted reverse-proxy IPs/CIDRs (X-Forwarded-For trust)
OWP_TRUSTED_PROXIES=

# phpMyAdmin backend URL
OWP_PHPMYADMIN_PORT=http://127.0.0.1:8080

# SMTP server
OWP_SMTP_PORT=2525
OWP_SMTP_TLS_CERT=
OWP_SMTP_TLS_KEY=

# Nginx paths (for auto-generated vhosts)
NGINX_PREFIX=/etc/nginx
NGINX_BIN=/usr/sbin/nginx
NGINX_CONF=/etc/nginx/nginx.conf
NGINX_LOG_DIR=/var/log/nginx

# PHP-FPM socket
PHP_FPM_SOCKET=/run/php/php8.3-fpm.sock

# MySQL/MariaDB (for user hosting databases)
MYSQL_ROOT_PASSWORD=your-mysql-root-password
